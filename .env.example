# Copy to .env and fill in. Never commit .env.

# --- Application -------------------------------------------------------------
APP_ENV=development            # development | testing | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                # json | console

# --- LLM provider (used by OpenCode / future in-process agents) --------------
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=

# --- Power BI / Fabric -------------------------------------------------------
# Service principal for REST API operations (Phase 8). Leave empty for interactive auth.
POWERBI_ENABLED=false
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
# Command used to launch the Power BI Modeling MCP server.
POWERBI_MCP_COMMAND=npx -y @microsoft/powerbi-modeling-mcp@latest --start

# --- Local storage -------------------------------------------------------------
WORKSPACES_DIR=workspaces
DUCKDB_PATH=

# --- Safety switches ---------------------------------------------------------
# Publishing is not implemented yet (Phase 8); this stays false until it is.
ALLOW_PUBLISH=false
REQUIRE_CONFIRMATION=true

# --- SQL sources ---------------------------------------------------------------
# DataSource.connection_env names a variable like this one. Keep URLs here, not in specs.
# SALES_DB_URL=postgresql+psycopg://user:password@host:5432/db
